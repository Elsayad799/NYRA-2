# NYRA AI - only these values are needed from you
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_IDS=PUT_YOUR_TELEGRAM_ID_HERE

# Optional behavior
DEBUG=false
AUTONOMOUS_MODE=true
AUTONOMOUS_INTERVAL=60
AUTONOMOUS_BUDGET_PER_HOUR=6
GLOBAL_COOLDOWN=2
GROUP_COOLDOWN=12
USER_COOLDOWN=3
MAX_HISTORY=16
MAX_MEMORIES=12

# Image provider failover (tries in this order)
IMAGE_PROVIDER_ORDER=supplied_photo_source,pollinations,huggingface,comfyui,openai_compatible_image
# Optional Pollinations API key. Current official gateway supports Bearer auth.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=zimage
# Optional legacy compatibility endpoint (only if that public endpoint still works)
POLLINATIONS_LEGACY_URL=https://image.pollinations.ai/prompt
# Optional Hugging Face
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
# Optional local/self-hosted ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=
# Optional OpenAI-compatible image endpoint
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=black-forest-labs/FLUX.1-schnell

AUTO_TTS=true
TTS_LANGUAGE=ar


# Voice quality / recognition
NYRA_TTS_VOICE=ar-EG-SalmaNeural
NYRA_TTS_RATE=+0%
NYRA_TTS_PITCH=+0Hz
NYRA_TTS_VOLUME=+0%
NYRA_WHISPER_MODEL=small
NYRA_WHISPER_DEVICE=auto
NYRA_WHISPER_COMPUTE=int8

# Optional multimodal Vision-Language Model. Leave empty on Android if not available.
# Example local OpenAI-compatible server: http://127.0.0.1:11434/v1
NYRA_VISION_URL=
NYRA_VISION_MODEL=
NYRA_VISION_API_KEY=
NYRA_VISION_TIMEOUT=90

# Optional: supplied TgMusicBot/NTgCalls Voice + Video Chat engine
NYRA_TG_VOICE_BRIDGE_ENABLED=0
NYRA_TG_VOICE_BRIDGE_URL=http://127.0.0.1:8765
NYRA_TG_VOICE_BRIDGE_TOKEN=
NYRA_TG_VOICE_BRIDGE_TIMEOUT=8
NYRA_TG_VOICE_BRIDGE_ADDR=127.0.0.1:8765


# Voiceslab clone integration (uses the supplied original account/session flow)
NYRA_VOICE_CLONE_ENABLED=1
NYRA_VOICE_REFERENCE=assets/voice/nyra_voice.mp3
NYRA_VOICE_SESSION_FILE=sessions.json
NYRA_VOICE_EMAIL_WAIT_TIMEOUT=90
NYRA_VOICE_EMAIL_POLL_DELAY=3
NYRA_VOICE_TEMP_MAIL_API=https://api.internal.temp-mail.io/api/v3
NYRA_VOICE_CLONE_BASE_URL=https://voiceslab.io
